<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gameover_false_god"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_judgement_panel"
        android:elevation="16dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvTitle"
            style="@style/Text.Divine.Title"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.1"
            android:text="JUDGEMENT"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- RESULT -->
        <TextView
            android:id="@+id/tvCurrentResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            style="@style/Text.Divine.Title.Red"
            android:text="Purified · 45"
            android:textSize="18sp"
            android:letterSpacing="0.1"
            android:textColor="#FF3333"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#44FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- RECORDS -->
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            style="@style/Text.Divine.HighScore"-->
<!--            android:text="ARCHIVED SCRIPTURES"-->
<!--            android:textSize="13sp"-->
<!--            android:textStyle="italic"-->
<!--            android:letterSpacing="0.14"-->
<!--            android:textColor="#CCCCCC"-->
<!--            android:layout_gravity="center"-->
<!--            android:layout_marginTop="8dp"-->
<!--            android:layout_marginBottom="8dp"/>-->

<!--        <TextView-->
<!--            android:id="@+id/tvHighScoreList"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            style="@style/Text.Divine.HighScore"-->
<!--            android:text="0 · 0"-->
<!--            android:gravity="center"-->
<!--            android:lineSpacingExtra="6dp"-->
<!--            android:textColor="#EEEEEE"-->
<!--            android:layout_marginBottom="28dp"/>-->

        <!-- ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnReplay"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/Text.Divine.Button"
                android:textStyle="bold"
                android:text="DEFY GOD"
                android:textSize="13sp"
                android:letterSpacing="0.16"
                android:textColor="#111111"
                android:background="@drawable/btn_replay_divine"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/Text.Divine.Title.Red"
                android:text="ACCEPT FATE"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:textColor="#FF5555"
                android:background="@drawable/btn_menu_heresy"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
