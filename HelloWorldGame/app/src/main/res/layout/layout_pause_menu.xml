<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pause_false_god"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="@drawable/bg_ritual_panel"
        android:elevation="14dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            style="@style/Text.Divine.Title"
            android:text="PAUSED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="32dp"/>

        <!-- RESUME -->
        <TextView
            android:id="@+id/btnResume"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            style="@style/Text.Divine.Button"
            android:textStyle="bold"
            android:text="RESUME"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            android:textColor="#111111"
            android:background="@drawable/btn_resume_divine"
            android:layout_marginBottom="16dp"/>

        <!-- RESTART -->
        <TextView
            android:id="@+id/btnRestart"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            style="@style/Text.Divine.Title.White"
            android:text="REWRITE"
            android:textSize="13sp"
            android:letterSpacing="0.12"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_restart_blood"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="16dp"/>

        <!-- MENU -->
        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            style="@style/Text.Divine.Button"
            android:text="ABANDON"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:textColor="#FF4444"
            android:background="@drawable/btn_menu_heresy"/>
    </LinearLayout>

</FrameLayout>
