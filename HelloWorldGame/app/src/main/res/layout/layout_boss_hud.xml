<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
       CONTAINER CHÍNH: Giữ tỷ lệ khung hình 128:64 (2:1)
       Bạn có thể đổi width thành bao nhiêu tùy thích (ví dụ 300dp),
       height sẽ tự co giãn theo tỷ lệ này.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/healthBarContainer"
        android:layout_width="300dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="128:64"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">

        <!-- 1. HÌNH NỀN KHUNG (Frame Asset) -->
        <ImageView
            android:id="@+id/ivFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/glitch_healthbar"
            android:scaleType="fitXY"/>

        <!-- 2. CÁC ĐƯỜNG DÓNG (GUIDELINES)-->

        <!-- Dóng Trái: 41 / 128 = 0.3203 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.3203" />

        <!-- Dóng Phải: (41 + 78) / 128 = 0.9296 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9296" />

        <!-- Dóng Trên: 30 / 64 = 0.4687 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.47" />

        <!-- Dóng Dưới: (30 + 6) / 64 = 0.5625 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5625" />

        <!-- 3. THANH MÁU ĐỎ -->
        <ProgressBar
            android:id="@+id/pbBossHealth"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/boss_health_progress"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintTop_toTopOf="@id/guideTop"
            app:layout_constraintBottom_toBottomOf="@id/guideBottom"
            />

        <!-- 4. CHỮ SỐ MÁU-->
        <TextView
            android:id="@+id/tvBossHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:text="1000/1000"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.663"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>