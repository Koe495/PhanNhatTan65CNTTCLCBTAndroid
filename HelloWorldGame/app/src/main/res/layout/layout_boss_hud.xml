<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
       CONTAINER CHÍNH: Giữ tỷ lệ khung hình 128:64 (2:1)
       height sẽ tự co giãn theo tỷ lệ này.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/healthBarContainer"
        android:layout_width="300dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="5dp">

        <!-- 1. HÌNH NỀN KHUNG (Frame Asset) -->

        <!-- 2. CÁC ĐƯỜNG DÓNG (GUIDELINES)-->

        <!-- Dóng Trái:-->
        <ImageView
            android:id="@+id/ivFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/health_bar"
            tools:layout_editor_absoluteX="-16dp"
            tools:layout_editor_absoluteY="-65dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

        <!-- Dóng Phải: -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.917" />

        <!-- Dóng Trên: 30 / 64 = 0.4687 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.365" />

        <!-- Dóng Dưới: (30 + 6) / 64 = 0.5625 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.55" />

        <!-- 3. THANH MÁU -->
        <ProgressBar
            android:id="@+id/pbBossHealth"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/boss_health_progress"
            app:layout_constraintBottom_toBottomOf="@id/guideBottom"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toTopOf="@id/guideTop"
            app:layout_constraintVertical_bias="0.0" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="30dp"
            android:layout_height="27dp"
            android:layout_marginStart="53dp"
            android:layout_marginTop="55dp"
            android:src="@drawable/suit_heart"
            app:layout_constraintStart_toStartOf="@+id/ivFrame"
            app:layout_constraintTop_toTopOf="@+id/ivFrame" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="27dp"
            android:layout_marginStart="105dp"
            android:layout_marginTop="55dp"
            android:src="@drawable/suit_diamond"
            app:layout_constraintStart_toStartOf="@+id/ivFrame"
            app:layout_constraintTop_toTopOf="@+id/ivFrame" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="27dp"
            android:layout_marginTop="55dp"
            android:layout_marginEnd="105dp"
            android:src="@drawable/suit_club"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivFrame" />
        <ImageView
            android:layout_width="30dp"
            android:layout_height="27dp"
            android:layout_marginTop="55dp"
            android:layout_marginEnd="53dp"
            android:src="@drawable/suit_spade"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ivFrame" />

        <TextView
            android:id="@+id/tvBossHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="73dp"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:text="100000000000/100000000000"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.502"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>