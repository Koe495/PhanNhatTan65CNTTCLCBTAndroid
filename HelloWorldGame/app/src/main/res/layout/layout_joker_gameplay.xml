<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. KHU VỰC LỊCH SỬ BÀI (Góc Trái) -->

    <TextView
        android:id="@+id/tvComboTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="152dp"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:text=""
        android:textColor="#FFEB3B"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLastComboName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#AF818E"
        android:textSize="16sp"
        android:textStyle="italic"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        app:layout_constraintStart_toStartOf="@id/tvComboTitle"
        app:layout_constraintTop_toBottomOf="@id/tvComboTitle" />

    <!-- Danh sách bài lịch sử (Xếp dọc) -->
    <LinearLayout
        android:id="@+id/layoutHistoryContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvComboTitle"
        app:layout_constraintTop_toBottomOf="@id/tvLastComboName">
        <!-- Các ImageView lá bài sẽ được thêm vào đây bằng Code -->
    </LinearLayout>


    <!-- 2. KHU VỰC BÀI TRÊN TAY (Dưới cùng, Căn giữa) -->
    <LinearLayout
        android:id="@+id/layoutHandContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- Các ImageView lá bài trên tay sẽ được thêm vào đây -->
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>