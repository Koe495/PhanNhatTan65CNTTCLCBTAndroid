<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <!-- Hiệu ứng Particle Background -->
    <cuoiki.helloworldgame.ParticleBackgroundView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvHighScoreTile"
            android:text="HALL OF FAME"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="30dp"/>

        <!-- Classic Mode Scores -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/labelClassic"
            android:text="CLASSIC TRAVELLERS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvClassicScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="18sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            android:lines="6"/>

        <!-- Endless Mode Scores -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/labelEndless"
            android:text="ENDLESS SURVIVORS"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvEndlessScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textSize="18sp"
            android:textColor="#555555"
            android:gravity="center"
            android:lines="6"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe DOWN to Close"
            android:layout_marginTop="50dp"
            android:textColor="#888888"
            android:textStyle="italic"/>

    </LinearLayout>
</FrameLayout>