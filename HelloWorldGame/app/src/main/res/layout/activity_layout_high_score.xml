<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_archive_false_divinity"
    android:clickable="true"
    android:focusable="true">

    <!-- SACRED DUST / PARTICLES -->
    <cuoiki.helloworldgame.ParticleBackgroundView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvHighScoreTile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARCHIVED SCRIPTURES"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="#111111"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp"/>

        <!-- CLASSIC -->
        <TextView
            android:id="@+id/labelClassic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLASSIC PILGRIMS"
            android:textSize="18sp"
            android:letterSpacing="0.14"
            android:textColor="#222222"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvClassicScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 · 72\n02 · 61\n03 · 45"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_marginBottom="26dp"
            android:lines="6"/>

        <!-- ENDLESS -->
        <TextView
            android:id="@+id/labelEndless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENDLESS MARTYRS"
            android:textStyle="bold"
            android:textSize="18sp"
            android:letterSpacing="0.14"
            android:textColor="#8B0000"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvEndlessScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 · 128\n02 · 97\n03 · 81"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#333333"
            android:gravity="center"
            android:lines="6"/>

        <!-- FOOTNOTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWIPE DOWN TO SEAL THE ARCHIVE"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:textColor="#666666"
            android:layout_marginTop="48dp"/>
    </LinearLayout>
</FrameLayout>
